# ==========================================
# SMARTSTAY BACKEND ENVIRONMENT CONFIGURATION
# ==========================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env and replace placeholders with your local/cloud credentials.

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection URI (Local MongoDB Community or MongoDB Atlas Cloud URI)
MONGO_URI=mongodb://localhost:27017/smartstay_db

# Cryptographic JSON Web Token Secret (HMAC-SHA256)
# WARNING: Generate a cryptographically secure 256-bit random string for production.
JWT_SECRET=your_jwt_secret_key_here

# Third-Party Cloud CDN (Media & Maintenance Defect Photo Uploads) - Optional
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Outbound Email SMTP Gateway (Payment OTP Codes & System Alerts) - Optional
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_email_app_password

