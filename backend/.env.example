# SmartStay Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartstay?retryWrites=true&w=majority

# JWT Authentication Secret and Token Lifecycle
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Optional Cloudinary Media Storage (Module 4)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
